# Variáveis de ambiente do MOVA: só nomes, nunca valores.
# Onde cada valor vive e quem guarda: docs/infra/segredos.md.
#
# Local: copie para .env.staging.local (mova-staging) e rode `npm run dev:staging`.
# O .env.local de hoje ainda aponta para a PRODUÇÃO (ver AGENTS.md).
#
# Comentário sempre na linha de cima (nada depois do `=`): o scripts/dev-staging.ts
# lê com `parseEnv` do Node, que não é o parser do Next.
#
# Marcas: [obrigatória] o app não sobe ou a tela principal quebra sem ela;
#         [opcional] tem fallback no código ou só liga uma integração;
#         [script] lida só por scripts locais, não pelo app;
#         [alto poder] dá acesso real a dado ou a emissão fiscal.

# ─── Supabase ────────────────────────────────────────────────────────────────
# [obrigatória] URL do projeto (vai ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
# [obrigatória] chave pública do Supabase (vai ao navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [obrigatória] [alto poder] ignora RLS; Auth admin e Storage
SUPABASE_SERVICE_ROLE_KEY=
# [obrigatória] [alto poder] Postgres pelo Session pooler (Drizzle e scripts)
DATABASE_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
# [opcional] URL pública nos links de assinatura; fallback MOVA_URL, depois moto-chefe.vercel.app
NEXT_PUBLIC_APP_URL=
# [opcional] mesma URL; também usada por scripts/conciliacao
MOVA_URL=
# [opcional] remetente dos e-mails (Resend)
EMAIL_FROM=
# [opcional] destino dos leads da /convencao; fallback contato@meumova.com
LEADS_EMAIL_TO=

# ─── Fiscal ──────────────────────────────────────────────────────────────────
# [obrigatória] [alto poder] cifra credenciais e certificados A1 (src/lib/cripto.ts); o staging tem chave própria
CERT_MASTER_KEY=

# ─── Segurança de rotas ──────────────────────────────────────────────────────
# [obrigatória] autoriza /api/cron/* e /api/conciliacao/*; valor diferente em Production e Preview
CRON_SECRET=
# [opcional] autoriza /api/jarvis/*
JARVIS_API_TOKEN=
# [opcional] valida o webhook /api/webhooks/resend
RESEND_WEBHOOK_SECRET=

# ─── Integrações ─────────────────────────────────────────────────────────────
# [opcional] envio de e-mail
RESEND_API_KEY=
# [opcional] envio de WhatsApp (avisos)
MCPAI_WHATSAPP_URL=
# [opcional] destino dos alertas no WhatsApp (ex.: pedidos da fábrica)
WHATSAPP_ALERTA_NUMERO=
# [opcional] fallback global; o normal é por grupo, no banco (migração 0099)
MCPAI_ENDPOINT_URL=
# [opcional] callback OAuth do Bling
BLING_REDIRECT_URI=
# [opcional] fallback 'VENDA'
BLING_NATUREZA_OPERACAO=
# [opcional] callback OAuth do Kommo; fallback no domínio de produção
KOMMO_REDIRECT_URI=

# ─── Scripts locais ──────────────────────────────────────────────────────────
# [script] scripts/set-telegram-webhook.mjs e scripts/conciliacao
TELEGRAM_BOT_TOKEN=
# [script] scripts/set-telegram-webhook.mjs
TELEGRAM_WEBHOOK_SECRET=
# [script] scripts/conciliacao/agente.ts
TELEGRAM_CHAT_ID=
# [script] scripts/criar-usuarios.ts
DEFAULT_USER_PASSWORD=
# [script] senha dos usuários sintéticos (scripts/seed-staging.ts); valor no Bitwarden
SEED_SENHA=
# [script] teste local do certificado (src/lib/sefaz/certificado.test.ts)
NFSE_CERT_PATH=
NFSE_CERT_PASS=
# [script] caminho do pg_dump 17 (scripts/schema-diff.ts)
PG_DUMP=
