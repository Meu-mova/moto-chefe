# Variáveis de ambiente do MOVA: só nomes, nunca valores.
# Onde cada valor vive e quem guarda: docs/infra/segredos.md.
#
# Local: copie para .env.local com os valores do staging (mova-staging) e rode `npm run dev`.
# Produção nunca no .env.local: só em .env.production.local, usado de forma explícita.
#
# APAGUE a linha da variável que não for usar. Valor vazio não é "ausente": o
# código usa `??` em vários fallbacks, e `""` passa direto (ex.: link de
# assinatura sem domínio).
#
# Marcas: [obrigatória] o app não sobe ou a tela principal quebra sem ela;
#         [produção] o app sobe sem ela, mas um recurso de produção quebra;
#         [opcional] tem fallback no código ou só liga uma integração;
#         [script] lida só por scripts locais, não pelo app;
#         [alto poder] dá acesso real a dado ou a emissão fiscal.

# ─── Supabase ────────────────────────────────────────────────────────────────
# [obrigatória] URL do projeto (vai ao navegador)
NEXT_PUBLIC_SUPABASE_URL=
# [obrigatória] chave pública do Supabase (vai ao navegador)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [obrigatória] [alto poder] ignora RLS; Auth admin e Storage
SUPABASE_SERVICE_ROLE_KEY=
# [obrigatória] [alto poder] Postgres do Drizzle e dos scripts. O app usa o pooler Supavisor
# em transaction mode, porta 6543 (src/lib/db/index.ts); o staging usa o Session pooler, 5432
DATABASE_URL=

# ─── App ─────────────────────────────────────────────────────────────────────
# [opcional] URL pública nos links de assinatura; fallback MOVA_URL, depois moto-chefe.vercel.app.
# Em Preview na Vercel vale o host do próprio deployment (VERCEL_URL)
NEXT_PUBLIC_APP_URL=
# [opcional] mesma URL; também usada por scripts/conciliacao
MOVA_URL=

# ─── Fiscal ──────────────────────────────────────────────────────────────────
# [produção] [alto poder] cifra credenciais e certificados A1 (src/lib/cripto.ts); sem ela,
# Nota Gateway, MCPAI e certificado falham. O staging tem chave própria
CERT_MASTER_KEY=

# ─── Segurança de rotas ──────────────────────────────────────────────────────
# [produção] autoriza /api/cron/* e /api/conciliacao/* (sem ela, essas rotas dão 401)
CRON_SECRET=
# [opcional] autoriza /api/jarvis/*
JARVIS_API_TOKEN=

# ─── E-mail ──────────────────────────────────────────────────────────────────
# [opcional] envio pelo Resend; só funciona com EMAIL_FROM junto (src/lib/email.ts)
RESEND_API_KEY=
# [opcional] remetente; sem fallback: sem ela nenhum e-mail sai
EMAIL_FROM=
# [opcional] valida o webhook /api/webhooks/resend
RESEND_WEBHOOK_SECRET=
# [opcional] destino dos leads da /convencao; fallback contato@meumova.com
LEADS_EMAIL_TO=

# ─── Integrações ─────────────────────────────────────────────────────────────
# [opcional] envio de WhatsApp (avisos)
MCPAI_WHATSAPP_URL=
# [opcional] destino dos alertas no WhatsApp (ex.: pedidos da fábrica)
WHATSAPP_ALERTA_NUMERO=
# [opcional] fallback global; o normal é por grupo, no banco (migração 0099)
MCPAI_ENDPOINT_URL=
# [opcional] callback OAuth do Bling
BLING_REDIRECT_URI=
# [opcional] fallback 'VENDA'
BLING_NATUREZA_OPERACAO=
# [opcional] callback OAuth do Kommo; fallback mova.motochefesuldeminas.com.br/api/kommo/callback
KOMMO_REDIRECT_URI=

# ─── Usuários (scripts) ──────────────────────────────────────────────────────
# [script] senha inicial dos funcionários criados por scripts/criar-usuarios.ts
# (script da implantação: apaga dados de teste antes)
DEFAULT_USER_PASSWORD=
# [script] senha dos usuários sintéticos (scripts/seed-staging.ts); valor no Bitwarden
SEED_SENHA=

# ─── Outros scripts locais ───────────────────────────────────────────────────
# [script] scripts/set-telegram-webhook.mjs e scripts/conciliacao
TELEGRAM_BOT_TOKEN=
# [script] scripts/set-telegram-webhook.mjs
TELEGRAM_WEBHOOK_SECRET=
# [script] scripts/conciliacao/agente.ts
TELEGRAM_CHAT_ID=
# [script] teste local do certificado (src/lib/sefaz/certificado.test.ts)
NFSE_CERT_PATH=
NFSE_CERT_PASS=
# [script] caminho do pg_dump 17 (scripts/schema-diff.ts)
PG_DUMP=
#
# Não declarar aqui: LOCALAPPDATA é do próprio Windows (pasta do coletor da conciliação,
# scripts/conciliacao/base.ts); fora dele o script usa o home.
