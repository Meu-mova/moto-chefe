              "console.log('d1: HTTP ' + pm.response.code + ' ' + pm.response.text().slice(0, 400));",
              "const code = pm.response.code;",
              "const caminho = code === 400 ? '400' : (code >= 200 && code < 300 ? '2xx' : 'outro');",
              "pm.collectionVariables.set('caminhoD', caminho);",
              "pm.collectionVariables.set('d2Final', 'nao');",
              "pm.test('NG respondeu 400 com GW7324 ou 2xx', () => {",
              "  if (caminho === '400') pm.expect(pm.response.text()).to.include('GW7324');",
              "  else pm.expect(caminho).to.eql('2xx');",
