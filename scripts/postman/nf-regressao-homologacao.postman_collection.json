              "console.log(pm.info.requestName + ' #' + n + ': HTTP ' + pm.response.code + ' status=' + (status || JSON.stringify(j)) + ' protocolo=' + (j && j.protocoloAutorizacao) + (j && j.motivoStatus ? ' motivo=' + j.motivoStatus : ''));",
              "if (!FINAIS.includes(status) && n < limite) {",
              "  pm.collectionVariables.set(k, n);",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "  return;",
              "}",
              "pm.collectionVariables.unset(k);",
              "pm.test('chegou a status final em até ' + limite + ' consultas', () => pm.expect(FINAIS).to.include(status));",
              "pm.test('status = Autorizada', () => pm.expect(status).to.eql('Autorizada'));",
              "// Passo falhou: os seguintes dependem dele (chave, carta, cancelamento); encerra a coleção.",
              "if (status !== 'Autorizada') pm.execution.setNextRequest(null);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
