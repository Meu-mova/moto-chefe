            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/empresas/{{empresaId}}/nf-e/cartaCorrecao/{{idCarta}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "empresas",
            "{{empresaId}}",
            "nf-e",
            "cartaCorrecao",
            "{{idCarta}}"
          ]
        }
      }
    },
