        "body": {
          "mode": "raw",
          "raw": "{\"id\":\"{{idCarta}}\",\"ambienteEmissao\":\"Homologacao\",\"numero\":1,\"correcao\":\"{{textoCarta}}\",\"nfe\":{\"chaveAcesso\":\"{{chave}}\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
