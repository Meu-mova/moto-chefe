              "const k = 'tentativas:' + pm.info.requestName;",
              "const n = Number(pm.collectionVariables.get(k) || 0) + 1;",
              "const limite = Number(pm.collectionVariables.get('maxTentativas') || 20);",
              "let j = null; try { j = pm.response.json(); } catch (e) {}",
              "const status = j && !Array.isArray(j) ? String(j.status || '') : '';",
              "console.log(pm.info.requestName + ' #' + n + ': HTTP ' + pm.response.code + ' status=' + (status || JSON.stringify(j)) + ' numero=' + (j && j.numero) + (j && j.motivoStatus ? ' motivo=' + j.motivoStatus : ''));",
